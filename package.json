{
  "name": "@pi-extensions/lmstudio-models",
  "version": "3.0.0",
  "description": "Automatically fetch and register logical models from LM Studio REST API endpoints on startup",
  "keywords": [
    "lm-studio",
    "model-sync",
    "pi-package"
  ],
  "homepage": "https://github.com/vampaz/pi-custom-provider-lmstudio#readme",
