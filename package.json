  "repository": {
    "type": "git",
    "url": "git+https://github.com/vampaz/pi-custom-provider-lmstudio.git"
  },
  "files": [
    "index.ts"
  ],
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt --check .",
